menu "Limit switch test"

    choice LIMIT_SWITCHES_TEST_MODE
        prompt "Diagnostic mode"
        default LIMIT_SWITCHES_MODE_GPIO_IRQ
        help
            The default mode confirms both GPIO inputs after their levels hold
            for the configured debounce interval. Polling and PCNT modes are
            retained for diagnosis.

        config LIMIT_SWITCHES_MODE_INPUT_ONLY
            bool "Input-only: configure pins without reading them"

        config LIMIT_SWITCHES_MODE_POLLING
            bool "Polling: read both pins every 10 ms"

        config LIMIT_SWITCHES_MODE_GPIO_IRQ
            bool "GPIO interrupt: confirm both pin levels after each edge"

        config LIMIT_SWITCHES_MODE_PCNT
            bool "PCNT: hardware falling-edge counting"
    endchoice

    choice LIMIT_SWITCHES_BIAS_MODE
        prompt "GPIO20/GPIO21 internal bias"
        default LIMIT_SWITCHES_BIAS_PULLUP
        help
            Select only when hardware inspection requires an internal pull resistor.

        config LIMIT_SWITCHES_BIAS_NONE
            bool "No internal pull-up or pull-down"

        config LIMIT_SWITCHES_BIAS_PULLUP
            bool "Enable internal pull-up"

        config LIMIT_SWITCHES_BIAS_PULLDOWN
            bool "Enable internal pull-down"
    endchoice

    config LIMIT_SWITCHES_DEBOUNCE_MS
        int "GPIO level settle time in ms"
        range 1 500
        default 2
        help
            An edge only restarts this timer. The GPIO level is counted when
            it has held for the full interval.
endmenu
