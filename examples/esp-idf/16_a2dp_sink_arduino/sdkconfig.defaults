CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../16_a2dp_sink/partitions.csv"

# This board uses esp-extconn and its ESP32 wireless controller, not ESP-Hosted.
CONFIG_ESP_HOST_WIFI_ENABLED=y
CONFIG_ESP_WIFI_CONTROLLER_TARGET="esp32"
# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
CONFIG_ESP_WIFI_REMOTE_FORCE_DISABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
