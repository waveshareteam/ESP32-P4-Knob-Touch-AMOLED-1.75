{
  "$schema": "https://raw.githubusercontent.com/waveshareteam/esp32-repo-template/v1/schema/product.schema.json",
  "product": "ESP32-P4-Knob-Touch-AMOLED-1.75",
  "product_url": "https://www.waveshare.com/wiki/ESP32-P4-Knob-Touch-AMOLED-1.75",
  "tier": 0,
  "target": "esp32p4",
  "esp_idf": {
    "versions": [
      "v6.1"
    ]
  },
  "arduino": {
    "core": "3.3.12",
    "fqbn": "esp32:esp32:esp32p4:ChipVariant=postv3,FlashSize=32M,PartitionScheme=app13M_data7M_32MB,PSRAM=enabled"
  },
  "factory_firmware": {
    "esp_idf": "v6.1"
  },
  "overrides": {
    "markdown_audit": {
      "classification_rules": [
        {
          "category": "embedded_upstream",
          "patterns": [
            "examples/factory/components/brookesia_core/**",
            "examples/factory/components/esp-extconn/**",
            "examples/factory/components/usb_device_uac/**",
            "examples/esp-idf/16_a2dp_sink/tutorial/Example_A2DP_Sink.md"
          ]
        },
        {
          "category": "third_party",
          "patterns": [
            "examples/factory/components/XiaozhiApp/third_party/xiaozhi_esp32/**",
            "examples/arduino/libraries/lvgl/**"
          ]
        }
      ]
    },
    "ci_routing": {
      "esp_idf_shared_patterns": [
        "examples/esp-idf/common/knob_board/**",
        "examples/esp-idf/common/knob_wireless/**"
      ]
    }
  }
}
